    "type-check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@dotrino/identity": "0.105.0",
    "@dotrino/install": "0.3.2",
    "@dotrino/nav": "0.3.0",
    "@dotrino/proxy-client": "0.29.0",
    "@dotrino/remote-agent": "0.15.1",
    "@dotrino/reputation": "0.12.0",
    "@dotrino/store": "0.11.0",
    "@dotrino/topbar": "0.15.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0"
  },
  "overrides": {
    "@dotrino/store": "0.11.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^7.3.1"
