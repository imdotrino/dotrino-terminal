{
  "name": "dotrino-terminal",
  "private": true,
  "version": "0.9.11",
  "type": "module",
  "description": "Terminal del ecosistema Dotrino: abre una shell en tu máquina (la del vault) desde el navegador; solo tu dispositivo enlazado puede, cifrado punto a punto.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
