{
  "name": "@dotrino/terminal-agent",
  "version": "0.24.0",
  "description": "Dotrino Terminal: las ventanas de esta máquina (dotrino-terminal) y su agente, que deja abrir esas mismas consolas desde los otros aparatos de tu cuenta, cifrado punto a punto.",
  "type": "module",
  "bin": {
    "dotrino-terminal-agent": "bin/cli.js",
    "dotrino-terminal": "bin/terminal.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "access.js",
    "editors.js",
    "consoles.js",
    "link.js",
    "local.js",
    "title.js",
    "bin"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.107.2",
    "@dotrino/proxy-client": "0.29.0",
    "@dotrino/remote-agent": "0.15.1",
    "@dotrino/update": "0.2.2",
    "@dotrino/vault": "0.79.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-terminal.git",
    "directory": "agent"
  },
  "homepage": "https://terminal.dotrino.com/",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@dotrino/webrtc": "0.1.0"
  }
}
