{
  "name": "@dotrino/terminal-agent",
  "version": "0.5.0",
  "description": "Agente de Dotrino Terminal: abre una shell (PTY) en esta máquina solo para los aparatos de tu cuenta, cifrada punto a punto, vía @dotrino/remote-agent.",
  "type": "module",
  "bin": {
    "dotrino-terminal-agent": "bin/cli.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "consoles.js",
    "link.js",
    "bin"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.105.0",
    "@dotrino/proxy-client": "0.25.0",
    "@dotrino/remote-agent": "0.12.0",
    "@dotrino/update": "0.2.2",
    "@dotrino/vault": "0.74.0",
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1-beta.2",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-terminal.git",
    "directory": "agent"
  },
  "homepage": "https://terminal.dotrino.com/",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
