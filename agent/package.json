{
  "name": "@dotrino/terminal-agent",
  "version": "0.47.4",
  "description": "Dotrino Terminal: las ventanas de esta máquina (dotrino-terminal) y su agente, que deja abrir esas mismas consolas desde los otros aparatos de tu cuenta, cifrado punto a punto.",
  "type": "module",
  "bin": {
    "dotrino-terminal-agent": "bin/cli.js",
    "dotrino-terminal": "bin/terminal.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "access.js",
    "far.js",
    "editors.js",
    "claude.js",
    "consoles.js",
    "desktop.js",
    "link.js",
    "local.js",
    "service.js",
    "title.js",
    "update.js",
    "uploads.js",
    "bin",
    "skills"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.116.0",
    "@dotrino/proxy-client": "0.32.0",
    "@dotrino/remote-agent": "0.18.3",
    "@dotrino/update": "0.9.0",
    "@dotrino/vault": "0.86.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15",
    "sigstore": "5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-terminal.git",
    "directory": "agent"
  },
  "homepage": "https://terminal.dotrino.com/",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@dotrino/webrtc": "0.1.0"
  }
}
